keywords:
  - "deep learning"
  - "light-sheet microscopy"
  - "tissue clearing"
  - "whole-body imaging"
  - "obesity"
  - "nerve segmentation"
  - "immune cell quantification"
  - "nnU-Net"
  - "vessel graph extraction"
